# Пример файла настроек.
# Чтобы изменить настройки, скопируй этот файл под именем .env и поправь значения:
#     cp .env.example .env
# Без файла .env приложение работает со значениями по умолчанию.

# Название в шапке сайта
APP_NAME="Учебная платформа"

# Где лежит база данных. Менять не нужно, пока не понадобится другая база.
# DATABASE_URL=sqlite:////app/data/app.db

# Часовой пояс: по нему приложение понимает, какой сегодня день.
# Примеры: Europe/Moscow, Asia/Yekaterinburg, Asia/Krasnoyarsk, Asia/Vladivostok
TIMEZONE=Europe/Moscow

# Сколько новых карточек для повторения показывать в день
NEW_CARDS_PER_DAY=10

# --- ИИ-наставник ---
# Чат на странице темы через локальную модель в Ollama.
# Чтобы включить: установи Ollama, скачай модель и поставь true (см. README).
AI_MENTOR_ENABLED=false
# Адрес Ollama. Менять не нужно, если Ollama установлена на этом же компьютере.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Модель. Должна быть скачана командой: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
# Сколько секунд ждать ответа модели
OLLAMA_TIMEOUT_SECONDS=180
