# Dockerfile — рецепт, по которому Docker собирает «образ»:
# готовую коробку с Python, библиотеками и нашим кодом.

# Берём за основу официальный образ с Python 3.12 (slim = без лишнего).
FROM python:3.12-slim

# Настройки Python внутри контейнера:
#   PYTHONDONTWRITEBYTECODE — не создавать служебные файлы .pyc;
#   PYTHONUNBUFFERED        — сразу печатать логи, а не копить их;
#   PIP_NO_CACHE_DIR        — не хранить кэш pip, образ будет меньше.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Рабочая папка внутри контейнера. Все следующие команды выполняются в ней.
WORKDIR /app

# Сначала копируем только списки библиотек и устанавливаем их.
# Docker запоминает результат каждого шага: пока эти файлы не менялись,
# библиотеки не будут скачиваться заново при каждой пересборке.
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Теперь копируем код приложения (что именно НЕ копировать — см. .dockerignore).
COPY . .

# Папка для базы данных. При запуске через compose на её место
# подключается твоя папка data/ с компьютера.
RUN mkdir -p data

# Приложение слушает порт 8000 (это пометка для человека, порт открывает compose).
EXPOSE 8000

# Команда при старте контейнера:
#   1) применить миграции — привести базу к актуальной структуре;
#   2) запустить веб-сервер. 0.0.0.0 = принимать запросы снаружи контейнера.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
