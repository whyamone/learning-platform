# Что НЕ попадает в git.

# Виртуальное окружение и служебные файлы Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Личные настройки (пример лежит в .env.example)
.env

# База данных с твоим прогрессом — личные данные, а не код.
# Сама папка data/ остаётся в git благодаря пустому файлу .gitkeep.
data/*
!data/.gitkeep

# Файлы редакторов и операционных систем
.idea/
.vscode/
.DS_Store
Thumbs.db
